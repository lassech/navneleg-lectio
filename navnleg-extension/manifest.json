{
  "manifest_version": 3,
  "name": "Navneleg for Lectio",
  "version": "1.0.1",
  "description": "Øv navnene på eleverne på et Lectio-hold med flashcards og quiz.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.lectio.dk/lectio/*/subnav/members.aspx*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
